# 저장소 안에서는 항상 LF로 보관합니다.
# .editorconfig(end_of_line = lf)와 일치시키고, OS가 다른 환경에서
# 줄바꿈만 바뀐 대량 diff가 생기는 것을 막습니다.
* text=auto eol=lf

# 명시적 지정
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf

# 바이너리 — 변환 금지
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# GitHub 언어 통계 보정 (문서·데이터가 코드 비율을 왜곡하지 않도록)
docs/*.md   linguist-documentation
data/*.json linguist-data
