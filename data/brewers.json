{
  "_meta": {
    "schema_version": "0.3",
    "updated": "2026-08-14",
    "note": "브루잉 드리퍼 카탈로그. flow_rate는 동일 분쇄도·동일 푸어 조건에서의 상대적 배출 속도이며 커뮤니티 통설과 구조적 특성(배출구 수/크기, 리브, 필터 두께)에 근거한 분류입니다. 실측값이 아닙니다.",
    "flow_rate_scale": [
      "very_slow",
      "slow",
      "medium",
      "fast",
      "very_fast"
    ],
    "thermal_mass_scale": [
      "low",
      "medium",
      "high"
    ],
    "다국어": [
      "name_base는 브랜드·모델명이라 번역하지 않습니다.",
      "재질 표기는 material 코드에서 terms.json으로 조회해 조합합니다. 예: 'Hario V60 02' + '(플라스틱 / Plastic)'",
      "show_material=false인 항목은 재질을 표시하지 않습니다(별칭이 있거나 재질 구분이 없는 모델).",
      "character / coach_note는 서술형이라 {ko, en, source_lang} 구조이며, en이 null이면 폴백 배지를 띄웁니다."
    ],
    "아이콘": [
      "icon은 assets/icons.js의 형태 키입니다. 제품 사진이 아니라 자체 SVG 선화입니다.",
      "제조사 사진은 저작권이 있어 쓸 수 없고, 형태만 남기는 편이 오히려 구분이 쉽습니다.",
      "cone 큰 배출구 원뿔 / cone_small 작은 배출구 원뿔 / flute 세로 주름 원뿔 /",
      "flat3 평바닥 3구 / flat1 평바닥 1구 / valve 밸브형 / hourglass 일체형 / press 가압",
      "icon이 없어도 icons.js가 geometry와 hole로 형태를 추정합니다."
    ]
  },
