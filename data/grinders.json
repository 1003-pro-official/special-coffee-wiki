    "IMPORTANT_설계_변경": [
      "마이크론 절대 환산은 그라인더 간 신뢰할 수 없습니다. 버 형상(코니컬/플랫), 버 직경, 정렬 상태, 제로 포인트 설정 방식이 모두 달라 '같은 800µm'이 같은 입도 분포를 뜻하지 않습니다.",
      "따라서 이 프로젝트는 마이크론을 1차 기준으로 쓰지 않습니다. 대신 각 그라인더의 'V60 표준 세팅'을 앵커로 저장하고, 레시피는 그 앵커로부터의 상대 오프셋(단계)으로 안내합니다.",
      "예: 레시피가 '중간-굵게 = 앵커 +2단계'이면, Comandante 사용자는 25+2=27클릭, Timemore C3 사용자는 20+2=22클릭으로 표시됩니다.",
      "micron_per_click은 보조 참고값으로만 저장하고 UI에서는 '추정'으로 표기합니다."
    ],

    "grind_band_scale": {
      "-3": "매우 곱게 (에스프레소~에어로프레스)",
      "-2": "곱게",
      "-1": "약간 곱게",
      "0": "V60 표준 (앵커)",
      "1": "약간 굵게",
      "2": "중간-굵게 (칼리타/중볶음)",
      "3": "굵게 (케멕스/프렌치프레스 근처)",
      "4": "매우 굵게 (콜드브루)"
    },

    "step_size_note": "각 그라인더의 step_per_band는 '1밴드 이동 시 몇 클릭을 돌려야 하는가'입니다. 미세 조절 그라인더(1Zpresso J계열 등)는 이 값이 큽니다.",
    "confidence": "high = 제조사 공식 또는 다수 출처 일치 / medium = 커뮤니티 통설 / low = 추정, 실측 필요"
  },

